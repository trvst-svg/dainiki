@page "/journals/{Id:int}"
@inject NavigationManager Navigation
@inject IJournalService JournalService
@inject Services.ISettings Settings

<div class="page-header">
    <div>
        <h1 class="page-title">Journal entry</h1>
        <p class="page-subtitle">Entry details, mood tracking, and tags.</p>
    </div>
    <div class="btn-row">
        <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/journals")'>Back to list</button>
        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo($"/newjournal/{Id}")'>Edit entry</button>
    </div>
</div>

@if (entry == null)
{
    <div class="card">
        <p>Entry not found.</p>
    </div>
}
else
{
    <div class="grid-2">
        <div class="card reveal" style="--delay: 0.05s;">
            <div class="card-header">
                <h3 class="card-title">@entry.Title</h3>
                <span class="badge">@entry.Date</span>
            </div>
            <div class="ql-editor markdown-body">@entry.ContentHtml</div>
        </div>

        <div class="card reveal" style="--delay: 0.1s;">
            <h3 class="section-title">Mood tracking</h3>
            <div class="table-list">
                <div class="list-item">
                    <div>
                        <div class="timeline-title">Primary mood</div>
                        <div class="list-meta">@entry.PrimaryMood</div>
                    </div>
                    <span class="badge">Required</span>
                </div>
                <div class="list-item">
                    <div>
                        <div class="timeline-title">Secondary moods</div>
                        <div class="list-meta">@entry.SecondaryMoods</div>
                    </div>
                </div>
                <div class="list-item">
                    <div>
                        <div class="timeline-title">Category</div>
                        <div class="list-meta">@entry.Category</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card reveal" style="--delay: 0.15s;">
        <h3 class="section-title">Tags</h3>
        <div class="chip-group">
            @foreach (var tag in entry.Tags)
            {
                <span class="chip chip--active">@tag</span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private JournalEntry? entry;

    protected override async Task OnParametersSetAsync()
    {
        if (Settings.CurrentUser == null)
        {
            entry = null;
            return;
        }

        var journal = await JournalService.GetJournal(Id, Settings.CurrentUser.username);
        if (journal == null)
        {
            entry = null;
            return;
        }

        var primaryMood = journal.JournalMoods.FirstOrDefault(mood => mood.mood_role == "Primary")?.mood?.mood_name ?? "None";
        var secondary = journal.JournalMoods
            .Where(mood => mood.mood_role == "Secondary")
            .Select(mood => mood.mood?.mood_name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList();

        var tags = journal.JournalTags
            .Where(tag => tag.tag != null && !string.IsNullOrWhiteSpace(tag.tag.tag_name))
            .Select(tag => tag.tag!.tag_name)
            .ToArray();

        entry = new JournalEntry(
            journal.journal_id,
            journal.journal_title,
            journal.journal_date.ToString("MMM dd, yyyy"),
            primaryMood,
            secondary.Count == 0 ? "None" : string.Join(", ", secondary),
            journal.category?.category_name ?? "Uncategorized",
            tags,
            new MarkupString(journal.journal_content_url));
    }

    private record JournalEntry(
        int Id,
        string Title,
        string Date,
        string PrimaryMood,
        string SecondaryMoods,
        string Category,
        string[] Tags,
        MarkupString ContentHtml);
}
