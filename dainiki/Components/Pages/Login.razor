@page "/login"
@layout AuthLayout
@inject NavigationManager Navigation

<div class="auth-shell">
    <div class="auth-card reveal">
        <h1 class="auth-title">Welcome to Dainiki</h1>

        <form @onsubmit="loginValidator">
            <div class="form-field">
                <label class="form-label" for="username">Username</label>
                <input class="input" type="text" id="username" @bind="username" placeholder="Enter your username" />
            </div>

            <div class="form-field">
                <label class="form-label" for="password">Password</label>
                <input class="input" type="password" id="password" @bind="password" placeholder="Enter your password" />
            </div>

            <div class="btn-row" style="margin-top: 18px; justify-content: center;">
                <button class="btn btn-primary" type="submit">Login</button>
            </div>
        </form>

        <div class="auth-footer">
            <span class="auth-helper">New here?</span>
            <NavLink href="signup">Signup</NavLink>
        </div>
    </div>
</div>

@code{
    private string username = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;

    async Task loginValidator()
    {
        if (String.IsNullOrWhiteSpace(username) || String.IsNullOrWhiteSpace(password))
        {
            message = "username or password invalid";
            return;
        }

        message = "logged in successfully";
        Console.WriteLine("Login method called");
        Navigation.NavigateTo("home");
    }
}
