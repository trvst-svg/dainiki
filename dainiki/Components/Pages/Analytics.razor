@page "/dashboard"
@page "/analytics"
@inject AnalyticsService AnalyticsService
@inject AppState AppState

<div class="page-header">
    <div>
        <h1 class="page-title">@pageTitle</h1>
        <p class="page-subtitle">@pageSubtitle</p>
    </div>
</div>

<details class="filter-panel">
    <summary>Analytics range</summary>
    <div class="form-grid" style="margin-top: 12px;">
        <div class="form-field">
            <label class="form-label">From</label>
            <input class="input" type="date" @bind="analyticsStartDate" />
        </div>
        <div class="form-field">
            <label class="form-label">To</label>
            <input class="input" type="date" @bind="analyticsEndDate" />
        </div>
    </div>
    <div style="margin-top: 12px;">
        <button class="btn btn-primary" type="button" @onclick="ApplyRange">Apply</button>
    </div>
</details>

<div class="dashboard-grid">
    <div class="dashboard-main">
        <div class="card chart-box">
            <h3 class="section-title">@consistencyLabel</h3>
            <div class="chart-surface">
                <svg viewBox="0 0 120 80" preserveAspectRatio="none">
                    <polyline class="chart-line light" points="0,70 20,52 40,58 60,35 80,45 100,28 120,34"></polyline>
                    <polyline class="chart-line" points="0,62 20,58 40,46 60,24 80,30 100,18 120,22"></polyline>
                </svg>
            </div>
        </div>

        <div class="card chart-box">
            <h3 class="section-title">@wordCountLabel</h3>
            <div class="chart-surface">
                <svg viewBox="0 0 120 80" preserveAspectRatio="none">
                    <polyline class="chart-line light" points="0,68 20,60 40,44 60,52 80,32 100,40 120,26"></polyline>
                    <polyline class="chart-line" points="0,72 20,64 40,52 60,36 80,44 100,30 120,36"></polyline>
                </svg>
            </div>
            @if (wordCountTrend.Count > 0)
            {
                <div class="table-list" style="margin-top: 12px;">
                    @foreach (var point in wordCountTrend)
                    {
                        <div class="list-item">
                            <div class="timeline-title">@point.Date.ToString("MMM dd")</div>
                            <div class="list-meta">@point.WordCount words</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="dashboard-side">
        <div class="stat-box">
            <div class="stat-label">@highestWordCountLabel</div>
            <div class="stat-value">@highestWordCountValue</div>
        </div>

        <div class="stat-box">
            <div class="stat-label">@highestStreakLabel</div>
            <div class="streak-preview">
                <div class="streak-image">Streak image</div>
                <div>
                    <div class="stat-value">@highestStreakValue</div>
                    <div class="stat-meta">@highestStreakRange</div>
                </div>
            </div>
        </div>

        <div class="stat-box">
            <div class="stat-label">@currentStreakLabel</div>
            <div class="stat-value">@currentStreakValue</div>
        </div>

        <div class="stat-box">
            <div class="stat-label">@missedDaysLabel</div>
            <div class="stat-value">@missedDaysValue</div>
        </div>

        <div class="stat-box">
            <div class="stat-label">@frequentMoodsLabel</div>
            <ol class="stat-list">
                @foreach (var mood in frequentMoods)
                {
                    <li>@mood</li>
                }
            </ol>
        </div>

        <div class="stat-box">
            <div class="stat-label">@moodDistributionLabel</div>
            <ol class="stat-list">
                @foreach (var mood in moodDistribution)
                {
                    <li>@mood</li>
                }
            </ol>
        </div>

        <div class="stat-box">
            <div class="stat-label">@usedTagsLabel</div>
            <ol class="stat-list">
                @foreach (var tag in usedTags)
                {
                    <li>@tag</li>
                }
            </ol>
        </div>

        <div class="stat-box">
            <div class="stat-label">@tagBreakdownLabel</div>
            <ol class="stat-list">
                @foreach (var tag in tagBreakdown)
                {
                    <li>@tag</li>
                }
            </ol>
        </div>
    </div>
</div>

@code {
    private string pageTitle = "Dashboard";
    private string pageSubtitle = "Track consistency, streaks, and mood patterns.";
    private string consistencyLabel = "Journal consistency chart";
    private string wordCountLabel = "Word count history";

    private string highestWordCountLabel = "Highest word count";
    private string highestWordCountValue = "No entries yet";

    private string highestStreakLabel = "Highest streak till date";
    private string highestStreakValue = "0 days";
    private string highestStreakRange = "Not enough data";

    private string currentStreakLabel = "Current streak";
    private string currentStreakValue = "0 days";

    private string missedDaysLabel = "Missed days";
    private string missedDaysValue = "0";

    private string frequentMoodsLabel = "Most frequent moods";
    private List<string> frequentMoods = new();

    private string moodDistributionLabel = "Mood distribution";
    private List<string> moodDistribution = new();

    private string usedTagsLabel = "Most used tags";
    private List<string> usedTags = new();

    private string tagBreakdownLabel = "Tag breakdown";
    private List<string> tagBreakdown = new();
    private List<AnalyticsService.WordCountPoint> wordCountTrend = new();
    private DateTime? analyticsStartDate = DateTime.Today.AddDays(-30);
    private DateTime? analyticsEndDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetricsAsync();
    }

    private async Task ApplyRange()
    {
        await LoadMetricsAsync();
    }

    private async Task LoadMetricsAsync()
    {
        if (AppState.CurrentUser == null)
        {
            return;
        }

        var metrics = await AnalyticsService.GetMetricsAsync(
            AppState.CurrentUser.username,
            analyticsStartDate,
            analyticsEndDate);

        highestWordCountValue = metrics.HighestWordCountEntry == null
            ? "No entries yet"
            : $"{metrics.HighestWordCountEntry.journal_title} ({metrics.HighestWordCountEntry.word_count} words)";

        highestStreakValue = $"{metrics.LongestStreak} days";

        if (metrics.LongestStreak > 0)
        {
            highestStreakRange = "Based on recorded entries";
        }

        currentStreakValue = $"{metrics.CurrentStreak} days";
        missedDaysValue = metrics.MissedDays.ToString();

        frequentMoods = metrics.FrequentMoods.Count == 0 ? new List<string> { "No moods yet" } : metrics.FrequentMoods.ToList();
        moodDistribution = metrics.MoodDistribution.Count == 0
            ? new List<string> { "No distribution yet" }
            : metrics.MoodDistribution.Select(entry => $"{entry.Key} ({entry.Value})").ToList();
        usedTags = metrics.FrequentTags.Count == 0 ? new List<string> { "No tags yet" } : metrics.FrequentTags.ToList();
        tagBreakdown = metrics.TagBreakdown.Count == 0
            ? new List<string> { "No tag data yet" }
            : metrics.TagBreakdown.Select(entry => $"{entry.Key} ({entry.Value})").ToList();
        wordCountTrend = metrics.WordCountTrend.TakeLast(6).ToList();
    }
}
