@page "/signup"
@page "/"
@layout AuthLayout
@inject NavigationManager Navigation
@inject IAuthService AuthService

<div class="auth-shell">
    <div class="auth-card reveal">
        <h1 class="auth-title">Welcome to Dainiki</h1>

        <form @onsubmit="signupValidator" @onsubmit:preventDefault>
            <div class="form-field">
                <label class="form-label" for="username">Username</label>
                <input class="input" type="text" @bind="username" id="username" placeholder="Choose a username" />
            </div>

            <div class="form-field">
                <label class="form-label" for="password">Password</label>
                <input class="input" type="password" @bind="password" id="password" placeholder="Create a password" />
            </div>

            <div class="btn-row" style="margin-top: 18px; justify-content: center;">
                <button class="btn btn-primary" type="submit">Sign Up</button>
            </div>
        </form>

        <div class="auth-footer">
            <span class="auth-helper">Already have an account?</span>
            <NavLink href="/login">Login</NavLink>
        </div>

        <p style="margin-top: 15px;">@message</p>
    </div>
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;

    private async Task signupValidator()
    {
        var result = await AuthService.RegisterAsync(username, password);
        if (!result.Success)
        {
            message = result.ErrorMessage;
            return;
        }

        message = "Signed up successfully. Please log in.";
        Navigation.NavigateTo("/login");
    }
}
