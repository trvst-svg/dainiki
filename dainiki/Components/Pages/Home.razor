@page "/home"

@inject NavigationManager Navigation

<div class="center-stack">
    <div>
        <h1 class="page-title">Welcome back @username</h1>
    </div>

    <div class="streak-panel">
        <div class="streak-label">Streaks</div>
        <div class="list-meta">streaks will be displayed here</div>
    </div>

    <div class="btn-row" style="justify-content: center;">
        <button class="btn btn-primary" @onclick="newButton">Write today's dainiki</button>
    </div>
</div>

@code{
    const string username = "username";

    void newButton()
    {
        Navigation.NavigateTo("newjournal");
    }
}
