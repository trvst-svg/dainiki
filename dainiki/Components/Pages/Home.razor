@page "/home"

@inject NavigationManager Navigation
@inject Services.ISettings Settings
@inject IAnalyticsService AnalyticsService

<div class="center-stack">
    <div>
        <h1 class="page-title">Welcome back @username</h1>
    </div>

    <div class="streak-panel">
        <div class="streak-label">Streaks</div>
        @if (metrics == null)
        {
            <div class="list-meta">No streak data yet.</div>
        }
        else
        {
            <div class="list-meta">Current streak: @metrics.CurrentStreak day(s)</div>
            <div class="list-meta">Longest streak: @metrics.LongestStreak day(s)</div>
            <div class="list-meta">Missed days: @metrics.MissedDays</div>
        }
    </div>

    <div class="btn-row" style="justify-content: center;">
        <button class="btn btn-primary" @onclick="newButton">Write today's dainiki</button>
    </div>
</div>

@code{
    private string username => Settings.CurrentUser?.username ?? "friend";
    private DashboardMetrics? metrics;

    protected override async Task OnInitializedAsync()
    {
        if (Settings.CurrentUser != null)
        {
            metrics = await AnalyticsService.GetMetricsAsync(Settings.CurrentUser.username);
        }
    }

    void newButton()
    {
        Navigation.NavigateTo("newjournal");
    }
}
