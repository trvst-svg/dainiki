@page "/security"
@inject IAuthService AuthService
@inject DainikiDbContext DbContext
@inject Services.ISettings Settings

<div class="page-header">
    <div>
        <h1 class="page-title">Security & privacy</h1>
        <p class="page-subtitle">Protect your journal with a password or PIN, and control app locking.</p>
    </div>
</div>

<div class="grid-2">
    <div class="card reveal" style="--delay: 0.05s;">
        <h3 class="section-title">Set password</h3>
        <div class="form-field">
            <label class="form-label">New password</label>
            <input class="input" type="password" placeholder="Create a strong password" @bind="newPassword" />
        </div>
        <div class="form-field">
            <label class="form-label">Confirm password</label>
            <input class="input" type="password" placeholder="Re-enter password" @bind="confirmPassword" />
        </div>
        <button class="btn btn-primary" @onclick="SaveSecurity">Save password</button>
    </div>

    <div class="card reveal" style="--delay: 0.1s;">
        <h3 class="section-title">PIN & lock settings</h3>
        <div class="form-field">
            <label class="form-label">PIN code</label>
            <input class="input" type="password" placeholder="4-digit PIN" @bind="pin" />
        </div>
        <div class="form-field">
            <label class="form-label">Auto-lock</label>
            <label class="toggle"><input type="checkbox" @bind="autoLock" /> Lock after 2 minutes idle</label>
        </div>
        <div class="form-field">
            <label class="form-label">Privacy mode</label>
            <label class="toggle"><input type="checkbox" @bind="hidePreview" /> Hide journal previews</label>
        </div>
        <div class="btn-row">
            <button class="btn btn-secondary" @onclick="SaveSecurity">Save settings</button>
            <button class="btn btn-danger" type="button">Lock now</button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p style="color: var(--accent-3);">@message</p>
}

@code {
    private bool autoLock = true;
    private bool hidePreview;
    private string? message;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string pin = string.Empty;

    protected override void OnInitialized()
    {
        if (Settings.CurrentUser != null)
        {
            autoLock = Settings.CurrentUser.auto_lock;
            hidePreview = Settings.CurrentUser.hide_preview;
        }
    }

    private async Task SaveSecurity()
    {
        if (Settings.CurrentUser == null)
        {
            message = "Please log in before updating security settings.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(newPassword))
        {
            if (newPassword != confirmPassword)
            {
                message = "Passwords do not match.";
                return;
            }

            var passwordResult = await AuthService.UpdatePasswordAsync(Settings.CurrentUser.username, newPassword);
            if (!passwordResult.Success)
            {
                message = passwordResult.ErrorMessage;
                return;
            }
        }

        if (!string.IsNullOrWhiteSpace(pin))
        {
            var pinResult = await AuthService.UpdatePinAsync(Settings.CurrentUser.username, pin);
            if (!pinResult.Success)
            {
                message = pinResult.ErrorMessage;
                return;
            }
        }

        var user = await DbContext.Users.FirstOrDefaultAsync(candidate => candidate.username == Settings.CurrentUser.username);
        if (user != null)
        {
            user.auto_lock = autoLock;
            user.hide_preview = hidePreview;
            await DbContext.SaveChangesAsync();
            Settings.UpdateUserSettings(hidePreview, autoLock, null);
        }

        message = "Security settings saved.";
        newPassword = string.Empty;
        confirmPassword = string.Empty;
        pin = string.Empty;
    }
}
