@page "/journals"
@inject IJournalService JournalService
@inject DainikiDbContext DbContext
@inject Services.ISettings Settings
@inject NavigationManager Navigation

<div class="page-header">
    <div>
        <h1 class="page-title">@pageTitle</h1>
    </div>
    <div class="toolbar">
        <div class="toolbar-group">
            <label class="form-label">@viewLabel</label>
            <select class="select" @bind="viewChoice" @bind:after="OnViewChanged">
                @foreach (var view in viewOptions)
                {
                    <option value="@view">@view</option>
                }
            </select>
        </div>
        <div class="toolbar-group">
            <label class="form-label">@searchLabel</label>
            <input class="input" placeholder="Search title or content" @bind="searchTerm" />
        </div>
    </div>
</div>

<details class="filter-panel">
    <summary>@filterLabel</summary>
    <div class="form-grid" style="margin-top: 12px;">
        <div class="form-field">
            <label class="form-label">Date range</label>
            <div class="btn-row">
                <input class="input" type="date" @bind="startDate" />
                <input class="input" type="date" @bind="endDate" />
            </div>
        </div>
        <div class="form-field">
            <label class="form-label">Primary mood</label>
            <select class="select" @bind="selectedMoodId">
                <option value="">Any</option>
                @foreach (var mood in allMoods)
                {
                    <option value="@mood.mood_id">@mood.mood_name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label class="form-label">Tags</label>
            <select class="select" @bind="selectedTagId">
                <option value="">Any</option>
                @foreach (var tag in allTags)
                {
                    <option value="@tag.tag_id">@tag.tag_name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label class="form-label">Pinned only</label>
            <label class="toggle">
                <input type="checkbox" @bind="pinnedOnly" />
                Show starred entries
            </label>
        </div>
    </div>
    <div style="margin-top: 12px;">
        <div class="btn-row">
            <button class="btn btn-primary" type="button" @onclick="ApplyFilters">@applyLabel</button>
            <button class="btn btn-secondary" type="button" @onclick="ResetFilters">@resetLabel</button>
        </div>
    </div>
</details>

<div class="card">
    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <p class="list-meta">@loadError</p>
    }
    else if (entries.Count == 0)
    {
        <p class="list-meta">No entries match the current filters.</p>
    }
    else
    {
        <div class="table-list">
            @foreach (var entry in entries)
            {
                <div class="list-item">
                    <div>
                        <NavLink class="timeline-title" href="@($"/journals/{entry.Id}")">@entry.Title</NavLink>
                        <div class="list-meta">@entry.DateDisplay - @entry.Mood - @entry.Tags</div>
                    </div>
                    <div class="btn-row">
                        <NavLink class="btn btn-ghost" href="@($"/newjournal/{entry.Id}")">@editLabel</NavLink>
                        <button class="btn btn-danger" type="button" @onclick="() => DeleteEntry(entry.Id)">@deleteLabel</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="btn-row" style="justify-content: space-between; margin-top: 16px;">
        <button class="btn btn-ghost" type="button" disabled="@prevDisabled" @onclick="PrevPage">@prevLabel</button>
        <span class="list-meta">@pageMeta</span>
        <button class="btn btn-ghost" type="button" disabled="@nextDisabled" @onclick="NextPage">@nextLabel</button>
    </div>
</div>

<div class="journal-footer">
    <NavLink class="btn btn-secondary" href="/export">@exportLabel</NavLink>
</div>

@code {
    private string pageTitle = "Previous journals";
    private string viewLabel = "Change view";
    private string searchLabel = "Search";
    private string filterLabel = "Filters";
    private string applyLabel = "Apply filters";
    private string resetLabel = "Reset filters";
    private string editLabel = "Edit";
    private string deleteLabel = "Delete";
    private string prevLabel = "Previous";
    private string nextLabel = "Next";
    private string exportLabel = "Export as pdf";
    private string pageMeta = "Page 1 of 1";

    private string viewChoice = "List";
    private string searchTerm = string.Empty;
    private int? selectedMoodId;
    private int? selectedTagId;
    private DateTime? startDate;
    private DateTime? endDate;
    private bool pinnedOnly;

    private bool prevDisabled = true;
    private bool nextDisabled;
    private int pageNumber = 1;
    private const int pageSize = 6;
    private int totalCount;
    private string? loadError;

    private List<string> viewOptions = new()
    {
        "List", "Calendar"
    };

    private List<Mood> allMoods = new();
    private List<Tag> allTags = new();

    private List<JournalSummary> entries = new();

    private record JournalSummary(int Id, string Title, string DateDisplay, string Mood, string Tags);

    protected override async Task OnInitializedAsync()
    {
        if (Settings.CurrentUser == null)
        {
            loadError = "Please log in to view your journals.";
            return;
        }

        try
        {
            loadError = null;

            allMoods = await DbContext.Moods
                .OrderBy(mood => mood.mood_name)
                .ToListAsync();

            allTags = await DbContext.Tags
                .OrderBy(tag => tag.tag_name)
                .ToListAsync();

            await LoadEntries();
        }
        catch (Exception ex)
        {
            loadError = "Unable to load journals: " + ex.Message;
            entries = new List<JournalSummary>();
            totalCount = 0;
            pageMeta = "Page 1 of 1";
        }
    }

    private async Task LoadEntries()
    {
        if (Settings.CurrentUser == null)
        {
            loadError = "Please log in to view your journals.";
            return;
        }

        try
        {
            loadError = null;

            JournalFilters filters = new JournalFilters(
                startDate,
                endDate,
                selectedMoodId,
                selectedTagId,
                searchTerm,
                pinnedOnly);

            JournalPageResult result = await JournalService.GetJournals(
                Settings.CurrentUser.username,
                filters,
                pageNumber,
                pageSize);

            totalCount = result.TotalCount;
            entries = result.Items.Select(entry =>
            {
                var primaryMood = entry.JournalMoods.FirstOrDefault(mood => mood.mood_role == "Primary")?.mood?.mood_name ?? "No mood";
                var tags = string.Join(", ", entry.JournalTags
                    .Select(tag => tag.tag?.tag_name)
                    .Where(name => !string.IsNullOrWhiteSpace(name)));

                return new JournalSummary(
                    entry.journal_id,
                    entry.journal_title,
                    entry.journal_date.ToString("MMM dd, yyyy"),
                    primaryMood,
                    string.IsNullOrWhiteSpace(tags) ? "No tags" : tags);
            }).ToList();

            prevDisabled = pageNumber <= 1;
            nextDisabled = pageNumber * pageSize >= totalCount;
            var pageCount = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
            pageMeta = $"Page {pageNumber} of {pageCount}";
        }
        catch (Exception ex)
        {
            loadError = "Unable to load journals: " + ex.Message;
            entries = new List<JournalSummary>();
            totalCount = 0;
            prevDisabled = true;
            nextDisabled = true;
            pageMeta = "Page 1 of 1";
        }
    }

    private async Task ApplyFilters()
    {
        pageNumber = 1;
        await LoadEntries();
    }

    private async Task ResetFilters()
    {
        searchTerm = string.Empty;
        selectedMoodId = null;
        selectedTagId = null;
        startDate = null;
        endDate = null;
        pinnedOnly = false;
        pageNumber = 1;
        await LoadEntries();
    }

    private async Task PrevPage()
    {
        if (pageNumber <= 1)
        {
            return;
        }

        pageNumber--;
        await LoadEntries();
    }

    private async Task NextPage()
    {
        if (pageNumber * pageSize >= totalCount)
        {
            return;
        }

        pageNumber++;
        await LoadEntries();
    }

    private async Task DeleteEntry(int id)
    {
        if (Settings.CurrentUser == null)
        {
            return;
        }

        await JournalService.DeleteJournal(id, Settings.CurrentUser.username);
        await LoadEntries();
    }

    private void OnViewChanged()
    {
        if (viewChoice == "Calendar")
        {
            Navigation.NavigateTo("/calendar");
            return;
        }

        if (viewChoice == "Tags")
        {
            Navigation.NavigateTo("/tags");
        }
    }
}
