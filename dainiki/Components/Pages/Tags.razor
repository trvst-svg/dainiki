@page "/tags"
@inject DainikiDbContext DbContext

<div class="page-header">
    <div>
        <h1 class="page-title">Tags & categories</h1>
        <p class="page-subtitle">Manage custom tags and keep your journal organized.</p>
    </div>
    <div class="btn-row">
        <input class="input" placeholder="New tag" @bind="newTagName" />
        <button class="btn btn-primary" @onclick="AddTag">Add tag</button>
    </div>
</div>

<div class="grid-2">
    <div class="card reveal" style="--delay: 0.05s;">
        <h3 class="section-title">Popular tags</h3>
        <div class="chip-group">
            @foreach (var tag in tags)
            {
                <span class="chip chip--active">@tag.tag_name</span>
            }
        </div>
    </div>

    <div class="card reveal" style="--delay: 0.1s;">
        <h3 class="section-title">Categories</h3>
        <div class="table-list">
            @foreach (var category in categories)
            {
                <div class="list-item">
                    <div>
                        <div class="timeline-title">@category.Name</div>
                        <div class="list-meta">@category.Description</div>
                    </div>
                    <span class="badge">@category.Count entries</span>
                </div>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p style="color: var(--accent-3);">@message</p>
}

@code {
    private string? message;
    private string newTagName = string.Empty;

    private List<Tag> tags = new();
    private List<CategoryItem> categories = new();

    protected override async Task OnInitializedAsync()
    {
        tags = await DbContext.Tags
            .OrderBy(tag => tag.tag_name)
            .ToListAsync();

        var categoryList = await DbContext.Categories
            .Where(category => category.category_type == "Journal")
            .OrderBy(category => category.category_name)
            .ToListAsync();

        categories = await BuildCategoryItemsAsync(categoryList);
    }

    private async Task AddTag()
    {
        var trimmed = newTagName.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            message = "Tag name cannot be empty.";
            return;
        }

        var exists = await DbContext.Tags.AnyAsync(tag => tag.tag_name == trimmed);
        if (exists)
        {
            message = "That tag already exists.";
            return;
        }

        DbContext.Tags.Add(new Tag
        {
            tag_name = trimmed,
            system_tag = false
        });

        await DbContext.SaveChangesAsync();
        tags = await DbContext.Tags.OrderBy(tag => tag.tag_name).ToListAsync();
        newTagName = string.Empty;
        message = "Tag added.";
    }

    private async Task<List<CategoryItem>> BuildCategoryItemsAsync(List<Category> categoryList)
    {
        var items = new List<CategoryItem>();
        foreach (var category in categoryList)
        {
            var count = await DbContext.Journals.CountAsync(journal => journal.category_id == category.category_id);
            items.Add(new CategoryItem(category.category_name, "Journal category", count));
        }

        return items;
    }

    private record CategoryItem(string Name, string Description, int Count);
}
