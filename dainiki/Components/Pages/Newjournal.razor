@page "/newjournal"
@page "/newjournal/{Id:int?}"
@inject IJournalService JournalService
@inject DainikiDbContext DbContext
@inject Services.ISettings Settings
@inject IJSRuntime JS

<div class="page-header">
    <div>
        <h1 class="page-title">Write today's dainiki</h1>
        <p class="page-subtitle">Capture your mood, tag the day, and write freely.</p>
    </div>
</div>

<div class="grid-2">
    <div class="card reveal" style="--delay: 0.05s;">
        <h3 class="section-title">Entry details</h3>
        <div class="form-field">
            <label class="form-label">Title</label>
            <input class="input" placeholder="Title" @bind="title" />
        </div>
        <div class="form-field">
            <label class="form-label">Entry datetime</label>
            <div>
                <p>Date: @entryDate.ToString("dd MMM yyyy")</p>
               <p>Time: @entryTime</p>
            </div>
        </div>
        <div class="form-field">
            <label class="form-label">Category</label>
            <select class="select" @bind="categoryId">
                <option value="0">Select category</option>
                @foreach (var category in categories)
                {
                    <option value="@category.category_id">@category.category_name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label class="form-label">Primary mood</label>
            <select class="select" @bind="primaryMoodId">
                <option value="">Select mood</option>
                @foreach (var mood in moods)
                {
                    <option value="@mood.mood_id">@mood.mood_name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label class="form-label">Secondary mood 1</label>
            <select class="select" @bind="secondaryMood1Id">
                <option value="">Select mood</option>
                @foreach (var mood in moods)
                {
                    <option value="@mood.mood_id">@mood.mood_name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label class="form-label">Secondary mood 2</label>
            <select class="select" @bind="secondaryMood2Id">
                <option value="">Select mood</option>
                @foreach (var mood in moods)
                {
                    <option value="@mood.mood_id">@mood.mood_name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label class="toggle">
                <input type="checkbox" @bind="isPinned" /> Pin this entry
            </label>
        </div>
    </div>

    <div class="card reveal" style="--delay: 0.1s;">
        <h3 class="section-title">Tags</h3>
        <div class="chip-group">
            @foreach (var tag in allTags)
            {
                <button class="chip @(selectedTagIds.Contains(tag.tag_id) ? "chip--active" : "")" type="button" @onclick="() => ToggleTag(tag)">
                    @(selectedTagIds.Contains(tag.tag_id) ? "✓ " : "")@tag.tag_name
                </button>
            }
        </div>
        <div class="form-field" style="margin-top: 12px;">
            <label class="form-label">Add custom tag</label>
            <div class="btn-row">
                <input class="input" placeholder="New tag" @bind="newTagName" />
                <button class="btn btn-secondary" type="button" @onclick="AddCustomTag">Add</button>
            </div>
        </div>
    </div>
</div>

<div class="card reveal" style="--delay: 0.15s;">
    <h3 class="section-title">Write your content here</h3>
    <div id="@EditorId"></div>
</div>

<div class="btn-row">
    <button class="btn btn-primary" @onclick="SaveJournal">Save</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p style="color: var(--accent-3);">@message</p>
}

@code {
    [Parameter] public int? Id { get; set; }

    private string title = string.Empty;
    private string description = string.Empty;
    private string newTagName = string.Empty;
    private string? message;
    private bool quillReady;
    private bool refreshEditor;
    private bool editorInitFailed;

    private const string EditorId = "journal-editor";

    private DateTime entryDate = DateTime.Today;
    private TimeOnly entryTime = TimeOnly.FromDateTime(DateTime.Now);
    private int categoryId;
    private bool isPinned;

    private int? primaryMoodId;
    private int? secondaryMood1Id;
    private int? secondaryMood2Id;

    private List<Mood> moods = new();
    private List<Tag> allTags = new();
    private List<Category> categories = new();
    private HashSet<int> selectedTagIds = new();

    protected override async Task OnInitializedAsync()
    {
        if (Settings.CurrentUser == null)
        {
            return;
        }

        categories = await DbContext.Categories
            .Where(category => category.category_type == "Journal")
            .OrderBy(category => category.category_name)
            .ToListAsync();

        moods = await DbContext.Moods
            .Include(mood => mood.category)
            .OrderBy(mood => mood.category!.category_name)
            .ThenBy(mood => mood.mood_name)
            .ToListAsync();

        allTags = await DbContext.Tags
            .OrderBy(tag => tag.tag_name)
            .ToListAsync();

        if (Id.HasValue)
        {
            await LoadJournalAsync(Id.Value);
        }
        else if (categories.Count > 0)
        {
            categoryId = categories[0].category_id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!quillReady)
        {
            try
            {
                await JS.InvokeVoidAsync("dainikiQuill.initEditor", EditorId, description);
                quillReady = true;
                refreshEditor = false;
                return;
            }
            catch (JSException ex)
            {
                editorInitFailed = true;
                message = "Editor failed to load: " + ex.Message;
                return;
            }
        }

        if (refreshEditor)
        {
            try
            {
                await JS.InvokeVoidAsync("dainikiQuill.setHtml", EditorId, description);
                refreshEditor = false;
            }
            catch (JSException ex)
            {
                message = "Editor update failed: " + ex.Message;
            }
        }
    }

    private async Task LoadJournalAsync(int journalId)
    {
        if (Settings.CurrentUser == null)
        {
            return;
        }

        Journal? journal = await JournalService.GetJournalAsync(journalId, Settings.CurrentUser.username);
        if (journal == null)
        {
            message = "Entry not found.";
            return;
        }

        title = journal.journal_title;
        description = journal.journal_content_url;
        refreshEditor = true;
        entryDate = journal.journal_date;
        entryTime = TimeOnly.FromTimeSpan(journal.journal_time);
        categoryId = journal.category_id;
        isPinned = journal.is_pinned;

        var primaryMood = journal.JournalMoods.FirstOrDefault(mood => mood.mood_role == "Primary");
        primaryMoodId = primaryMood?.mood_id;

        var secondaryMoods = journal.JournalMoods
            .Where(mood => mood.mood_role == "Secondary")
            .Select(mood => mood.mood_id)
            .ToList();

        secondaryMood1Id = secondaryMoods.ElementAtOrDefault(0);
        secondaryMood2Id = secondaryMoods.ElementAtOrDefault(1);

        selectedTagIds = journal.JournalTags.Select(tag => tag.tag_id).ToHashSet();
    }

    private void ToggleTag(Tag tag)
    {
        if (selectedTagIds.Contains(tag.tag_id))
        {
            selectedTagIds.Remove(tag.tag_id);
        }
        else
        {
            selectedTagIds.Add(tag.tag_id);
        }
    }

    private async Task AddCustomTag()
    {
        var trimmed = newTagName.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return;
        }

        var existing = await DbContext.Tags.FirstOrDefaultAsync(tag => tag.tag_name == trimmed);
        if (existing != null)
        {
            selectedTagIds.Add(existing.tag_id);
            newTagName = string.Empty;
            return;
        }

        var tagEntry = new Tag
        {
            tag_name = trimmed,
            system_tag = false
        };

        DbContext.Tags.Add(tagEntry);
        await DbContext.SaveChangesAsync();
        allTags = await DbContext.Tags.OrderBy(tag => tag.tag_name).ToListAsync();
        selectedTagIds.Add(tagEntry.tag_id);
        newTagName = string.Empty;
    }

    private async Task SaveJournal()
    {
        if (Settings.CurrentUser == null)
        {
            message = "Please log in first.";
            return;
        }

        if (editorInitFailed)
        {
            message = "Editor is unavailable. Try reloading the page.";
            return;
        }

        try
        {
            description = await JS.InvokeAsync<string>("dainikiQuill.getHtml", EditorId);
        }
        catch (JSException ex)
        {
            message = "Unable to read editor content: " + ex.Message;
            return;
        }

        if (categoryId == 0)
        {
            message = "Please choose a category.";
            return;
        }

        var secondaryIds = new List<int>();
        if (secondaryMood1Id.HasValue)
        {
            secondaryIds.Add(secondaryMood1Id.Value);
        }

        if (secondaryMood2Id.HasValue)
        {
            secondaryIds.Add(secondaryMood2Id.Value);
        }

        DateTime entryDateTime = entryDate.Date.Add(entryTime.ToTimeSpan());

        JournalInput input = new JournalInput(
            Id,
            Settings.CurrentUser.username,
            title,
            description,
            entryDateTime,
            categoryId,
            isPinned,
            primaryMoodId,
            secondaryIds,
            selectedTagIds.ToList());

        JournalSaveResult result = await JournalService.SaveJournalAsync(input);

        if (!result.Success)
        {
            message = result.ErrorMessage;
            if (result.JournalId != 0)
            {
                Id = result.JournalId;
                await LoadJournalAsync(result.JournalId);
            }
            return;
        }

        message = result.WasCreated ? "Entry saved." : "Entry updated.";
        Id = result.JournalId;
    }
}
