@page "/calendar"
@using System.Net
@using System.Text.RegularExpressions
@inject IJournalService JournalService
@inject Services.ISettings Settings
@inject NavigationManager Navigation

<div class="page-header">
    <div>
        <h1 class="page-title">Calendar view</h1>
        <p class="page-subtitle">Navigate entries by date, spot streaks, and revisit reflections.</p>
    </div>
    <div class="btn-row">
        <button class="btn btn-secondary" @onclick="@GoPrevious">Previous</button>
        <button class="btn btn-secondary" @onclick="@GoNext">Next</button>
    </div>
</div>

<div class="grid-2">
    <div class="card reveal" style="--delay: 0.05s;">
        <div class="card-header">
            <h3 class="card-title">@monthLabel</h3>
            <span class="badge">Entries: @monthEntryCount</span>
        </div>

        <div class="calendar" style="margin-top: 16px;">
            @foreach (var dayName in weekDays)
            {
                <div class="calendar-day calendar-day--empty" style="text-align:center; font-size:0.75rem; color: var(--muted);">@dayName</div>
            }
            @foreach (var day in calendarDays)
            {
                if (day.IsPlaceholder)
                {
                    <div class="calendar-day calendar-day--empty"></div>
                }
                else
                {
                    <div class="calendar-day" @onclick="() => NavigateToEntry(day.EntryId)">
                        <div class="calendar-day__num">@day.DayNumber</div>
                        @if (day.HasEntry)
                        {
                            <span class="badge">Entry</span>
                        }
                        else
                        {
                            <span class="list-meta">No entry</span>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <div class="card reveal" style="--delay: 0.1s;">
        <h3 class="section-title">This week</h3>
        <div class="timeline">
            @foreach (var entry in entries)
            {
                <div class="timeline-card">
                    <div class="timeline-title">@entry.Title</div>
                    <div class="list-meta">@entry.Date · @entry.Mood</div>
                    <div style="margin-top: 6px; color: var(--muted);">@entry.Preview</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private DateTime month = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<CalendarDay> calendarDays = new();
    private int monthEntryCount;

    private string[] weekDays = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };

    private List<CalendarEntry> entries = new();
    private Dictionary<DateTime, Journal> journalByDate = new();

    private string monthLabel => month.ToString("MMMM yyyy");

    protected override async Task OnInitializedAsync()
    {
        await LoadMonthAsync();
    }

    private async Task LoadMonthAsync()
    {
        if (Settings.CurrentUser == null)
        {
            return;
        }

        var start = new DateTime(month.Year, month.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        var journals = await JournalService.GetJournalsInRangeAsync(Settings.CurrentUser.username, start, end);
        journalByDate = journals.ToDictionary(journal => journal.journal_date.Date);
        monthEntryCount = journals.Count;

        var weekStart = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek);
        var weekEnd = weekStart.AddDays(6);
        var hidePreview = Settings.CurrentUser.hide_preview;
        entries = journals
            .Where(journal => journal.journal_date.Date >= weekStart && journal.journal_date.Date <= weekEnd)
            .OrderByDescending(journal => journal.journal_date)
            .Select(journal =>
            {
                var primaryMood = journal.JournalMoods.FirstOrDefault(mood => mood.mood_role == "Primary")?.mood?.mood_name ?? "No mood";
                string previewText = TextHelpers.StripHtml(journal.journal_content_url);
                var preview = hidePreview
                    ? "Preview hidden"
                    : (previewText.Length > 80
                        ? previewText[..80] + "..."
                        : previewText);
                return new CalendarEntry(
                    journal.journal_date.ToString("ddd, MMM dd"),
                    primaryMood,
                    journal.journal_title,
                    preview);
            })
            .ToList();

        BuildCalendar();
    }

    private void BuildCalendar()
    {
        calendarDays.Clear();
        var firstDayOfMonth = new DateTime(month.Year, month.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
        var offset = (int)firstDayOfMonth.DayOfWeek;

        for (var i = 0; i < offset; i++)
        {
            calendarDays.Add(CalendarDay.Placeholder());
        }

        for (var day = 1; day <= daysInMonth; day++)
        {
            var date = new DateTime(month.Year, month.Month, day);
            var hasEntry = journalByDate.ContainsKey(date);
            calendarDays.Add(new CalendarDay(day, hasEntry, hasEntry ? journalByDate[date].journal_id : null));
        }
    }

    private async Task GoPrevious()
    {
        month = month.AddMonths(-1);
        await LoadMonthAsync();
    }

    private async Task GoNext()
    {
        month = month.AddMonths(1);
        await LoadMonthAsync();
    }

    private record CalendarEntry(string Date, string Mood, string Title, string Preview);

    private record CalendarDay(int DayNumber, bool HasEntry, int? EntryId, bool IsPlaceholder = false)
    {
        public static CalendarDay Placeholder() => new CalendarDay(0, false, null, true);
    }

    private void NavigateToEntry(int? entryId)
    {
        if (entryId.HasValue)
        {
            Navigation.NavigateTo($"/journals/{entryId.Value}");
        }
    }
}
