@page "/export"
@inject IJournalService JournalService
@inject IPdfExportService PdfExportService
@inject Services.ISettings Settings

<div class="page-header">
    <div>
        <h1 class="page-title">Export journals</h1>
        <p class="page-subtitle">Generate a PDF summary of your entries for a chosen date range.</p>
    </div>
    <div class="btn-row">
        <button class="btn btn-primary" @onclick="ExportPdf">Export PDF</button>
    </div>
</div>

<div class="grid-2">
    <div class="card reveal" style="--delay: 0.05s;">
        <h3 class="section-title">Date range</h3>
        <div class="form-field">
            <label class="form-label">From</label>
            <input class="input" type="date" @bind="startDate" @bind:after="LoadExportDataAsync" />
        </div>
        <div class="form-field">
            <label class="form-label">To</label>
            <input class="input" type="date" @bind="endDate" @bind:after="LoadExportDataAsync" />
        </div>
        <div class="form-field">
            <label class="form-label">Include</label>
            <label class="toggle"><input type="checkbox" @bind="includeMood" /> Mood tracking</label>
            <label class="toggle"><input type="checkbox" @bind="includeTags" /> Tags & categories</label>
            <label class="toggle"><input type="checkbox" @bind="includeAnalytics" @bind:after="LoadExportDataAsync" /> Analytics summary</label>
        </div>
    </div>

    <div class="card reveal" style="--delay: 0.1s;">
        <h3 class="section-title">Preview</h3>
        <div class="table-list">
            <div class="list-item">
                <div>
                    <div class="timeline-title">Selected range</div>
                    <div class="list-meta">@PreviewRange</div>
                </div>
                <span class="badge">PDF</span>
            </div>
            <div class="list-item">
                <div>
                    <div class="timeline-title">Included sections</div>
                    <div class="list-meta">@PreviewSections</div>
                </div>
            </div>
            <div class="list-item">
                <div>
                    <div class="timeline-title">Entries in range</div>
                    <div class="list-meta">@exportEntries.Count</div>
                </div>
            </div>
        </div>
        <p style="margin-top: 12px; color: var(--muted);">
            Exported files remain on this device. No cloud sync by default.
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p style="color: var(--accent-3);">@message</p>
}

@code {
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private bool includeMood = true;
    private bool includeTags = true;
    private bool includeAnalytics = true;
    private string? message;
    private List<ExportEntry> exportEntries = new List<ExportEntry>();

    private string PreviewRange
    {
        get { return startDate.ToString("MMM dd, yyyy") + " - " + endDate.ToString("MMM dd, yyyy"); }
    }

    private string PreviewSections
    {
        get
        {
            List<string> sections = new List<string>();
            if (includeMood)
            {
                sections.Add("Mood tracking");
            }
            if (includeTags)
            {
                sections.Add("Tags");
            }
            if (includeAnalytics)
            {
                sections.Add("Analytics");
            }

            if (sections.Count == 0)
            {
                return "None";
            }

            return string.Join(", ", sections);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadExportDataAsync();
    }

    private async Task ExportPdf()
    {
        if (Settings.CurrentUser == null)
        {
            message = "Please log in before exporting.";
            return;
        }

        await LoadExportDataAsync();

        try
        {
            string filePath = await PdfExportService.ExportAsync(
                Settings.CurrentUser.username,
                startDate,
                endDate,
                includeMood,
                includeTags,
                includeAnalytics);

            message = "Exported to " + filePath;
        }
        catch (Exception ex)
        {
            message = "Export failed: " + ex.Message;
        }
    }

    private async Task LoadExportDataAsync()
    {
        exportEntries.Clear();

        if (Settings.CurrentUser == null)
        {
            return;
        }

        DateTime rangeStart = startDate;
        DateTime rangeEnd = endDate;
        if (rangeEnd < rangeStart)
        {
            DateTime temp = rangeStart;
            rangeStart = rangeEnd;
            rangeEnd = temp;
        }

        List<Journal> entries = await JournalService.GetJournalsInRangeAsync(Settings.CurrentUser.username, rangeStart, rangeEnd);
        foreach (Journal entry in entries)
        {
            string title = entry.journal_title;
            string dateDisplay = entry.journal_date.ToString("MMM dd, yyyy");
            string moodDisplay = BuildMoodDisplay(entry);
            string tagsDisplay = BuildTagsDisplay(entry);
            string contentPreview = TextHelpers.StripHtml(entry.journal_content_url);

            ExportEntry exportEntry = new ExportEntry();
            exportEntry.Id = entry.journal_id;
            exportEntry.Title = title;
            exportEntry.DateDisplay = dateDisplay;
            exportEntry.MoodDisplay = moodDisplay;
            exportEntry.TagsDisplay = tagsDisplay;
            exportEntry.ContentPreview = contentPreview;
            exportEntries.Add(exportEntry);
        }

    }

    private static string BuildMoodDisplay(Journal journal)
    {
        string primary = "None";
        List<string> secondary = new List<string>();

        foreach (JournalMood journalMood in journal.JournalMoods)
        {
            if (journalMood.mood == null)
            {
                continue;
            }

            if (journalMood.mood_role == "Primary")
            {
                primary = journalMood.mood.mood_name;
            }
            else if (journalMood.mood_role == "Secondary")
            {
                secondary.Add(journalMood.mood.mood_name);
            }
        }

        if (secondary.Count == 0)
        {
            return primary;
        }

        return primary + " (Secondary: " + string.Join(", ", secondary) + ")";
    }

    private static string BuildTagsDisplay(Journal journal)
    {
        List<string> tags = new List<string>();
        foreach (JournalTag journalTag in journal.JournalTags)
        {
            if (journalTag.tag != null)
            {
                tags.Add(journalTag.tag.tag_name);
            }
        }

        if (tags.Count == 0)
        {
            return "None";
        }

        return string.Join(", ", tags);
    }

    private class ExportEntry
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string DateDisplay { get; set; } = string.Empty;
        public string MoodDisplay { get; set; } = string.Empty;
        public string TagsDisplay { get; set; } = string.Empty;
        public string ContentPreview { get; set; } = string.Empty;
    }
}
