@inherits LayoutComponentBase
@implements IDisposable
@inject dainiki.Components.Services.ISettings Settings
@inject NavigationManager Navigation

<div class="app-shell @ThemeClass">
    <aside class="side-nav">
        <div class="side-nav__brand">
            <div class="brand-mark">D</div>
            <div class="brand-title">Dainiki</div>
        </div>

        <NavMenu />
    </aside>

    <div class="main-pane">
        <main class="page">
            @Body
        </main>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Settings.OnChange += StateHasChanged;

        if (!Settings.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private string ThemeClass
    {
        get
        {
            var theme = Settings.CurrentUser?.theme;
            return string.IsNullOrWhiteSpace(theme) ? string.Empty : $"theme-{theme.ToLowerInvariant()}";
        }
    }

    public void Dispose()
    {
        Settings.OnChange -= StateHasChanged;
    }
}
